@startuml
title Vollständiges Klassendiagramm — Szenenmodell und Renderkern

left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 16
skinparam ranksep 22
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 14

package "math" {
  class Vector3 <<struct>> {
    +x, y, z: double = 0
    +length_squared(): double
    +length(): double
    +normalized(): Vector3
    +dot(rhs: Vector3): double
    +cross(rhs: Vector3): Vector3
    +hadamard(rhs: Vector3): Vector3
    +operator+(rhs: Vector3): Vector3
    +operator-(rhs: Vector3): Vector3
    +operator-(): Vector3
    +operator*(s: double): Vector3
    +operator/(s: double): Vector3
  }
  note right of Vector3
    Freie Funktion:
    operator*(s: double, v: Vector3): Vector3
  end note
}

package "geometry" {
  class Ray <<struct>> {
    +origin: Vector3
    +direction: Vector3
    +at(t: double): Vector3
  }

  enum TriangleIntersectionAlgorithm {
    Badouel
    MollerTrumbore
  }

  class Triangle <<struct>> {
    +a, b, c: Vector3
    +material: Material
    +normal_a, normal_b, normal_c: Vector3
    +has_vertex_normals: bool = false
    +intersect(ray: Ray, t_min: double, t_max: double, t_out: double&, u_out: double&, v_out: double&, algorithm = Badouel): bool
    +normal(): Vector3
    +shading_normal(u, v): Vector3
  }
}

package "world" {
  class Material <<struct>> {
    +diffuse: Vector3 = (0.8, 0.8, 0.8)
    +specular: Vector3 = (0, 0, 0)
    +shininess: double = 16
    +opacity: double = 1
    +refractive_index: double = 1.5
  }

  class Hit <<struct>> {
    +t, u, v: double = 0
    +triangle_index: std::size_t = 0
  }

  class World {
    -triangles_: std::vector<Triangle>
    +add_triangle(triangle: const Triangle&): void
    +intersect(ray: Ray, t_min: double, t_max: double, hit: Hit&, stats: RenderStats*, algorithm = Badouel): bool
    +triangles(): const std::vector<Triangle>&
    +bounds_min(): Vector3
    +bounds_max(): Vector3
  }
}

package "view" {
  class Camera {
    -origin_: Vector3
    -lower_left_: Vector3
    -horizontal_: Vector3
    -vertical_: Vector3
    +Camera(bounds_min: Vector3, bounds_max: Vector3, aspect_ratio: double)
    +ray(u: double, v: double): Ray
  }

  class Renderer {
    +ProgressCallback = std::function<void(int)>
    +render(world: World, camera: Camera, width: int, height: int, stats: RenderStats*, algorithm: TriangleIntersectionAlgorithm, progress: ProgressCallback): std::vector<Vector3>
  }
}

package "utility" {
  class RenderStats <<struct>> {
    +primary_rays: std::atomic<std::uint64_t> = 0
    +triangle_tests: std::atomic<std::uint64_t> = 0
    +aabb_tests: std::atomic<std::uint64_t> = 0
    +reset(): void
  }
}

note right of Renderer
  Interne Helfer aus renderer.cc:
  background, offset_origin, schlick_fresnel,
  light_visibility, refract und trace
end note

Ray *-- "2" Vector3
Triangle *-- "3" Vector3
Triangle *-- Material
World *-- "0..*" Triangle
World ..> Hit
World ..> RenderStats
World ..> TriangleIntersectionAlgorithm
Camera *-- "4" Vector3
Renderer ..> Camera
Renderer ..> World
Renderer ..> RenderStats
Renderer ..> TriangleIntersectionAlgorithm

@enduml
