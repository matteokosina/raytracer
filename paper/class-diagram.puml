@startuml
title C++20 Raytracer — zentrale Klassen und Renderablauf

left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 24
skinparam ranksep 30
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12

package "math" {
  class Vector3 <<struct>> {
    +x: double
    +y: double
    +z: double
    +normalized(): Vector3
    +dot(rhs): double
    +cross(rhs): Vector3
  }
}

package "geometry" {
  class Ray <<struct>> {
    +origin: Vector3
    +direction: Vector3
    +at(t): Vector3
  }

  enum TriangleIntersectionAlgorithm {
    Badouel
    MollerTrumbore
  }

  class Triangle <<struct>> {
    +a, b, c: Vector3
    +material: Material
    +normal_a, normal_b, normal_c: Vector3
    +has_vertex_normals: bool
    +intersect(ray, interval, algorithm): bool
    +normal(): Vector3
    +shading_normal(u, v): Vector3
  }
}

package "world" {
  class Material <<struct>> {
    +diffuse, specular: Vector3
    +shininess: double
    +opacity: double
    +refractive_index: double
  }

  class Hit <<struct>> {
    +t, u, v: double
    +triangle_index: size_t
  }

  class World {
    -triangles: vector<Triangle>
    +add_triangle(triangle): void
    +intersect(ray, interval, hit, stats, algorithm): bool
    +bounds_min(): Vector3
    +bounds_max(): Vector3
  }
}

package "view" {
  class Camera {
    -origin: Vector3
    -lower_left: Vector3
    -horizontal, vertical: Vector3
    +Camera(scene_bounds, aspect_ratio)
    +ray(u, v): Ray
  }

  class Renderer {
    +render(world, camera, size, stats, algorithm): vector<Vector3>
  }
}

package "utility" {
  class RenderStats <<struct>> {
    +primary_rays: atomic<uint64_t>
    +triangle_tests: atomic<uint64_t>
    +aabb_tests: atomic<uint64_t>
    +reset(): void
  }
}

note top of Renderer
  CLI / main orchestriert:
  OBJ/MTL laden → Kamera erzeugen →
  rendern → BMP schreiben.
  --mt wählt Möller–Trumbore,
  sonst gilt Badouel.
end note

Ray *-- "2" Vector3 : origin, direction
Triangle *-- Material
Triangle ..> TriangleIntersectionAlgorithm : Verfahren
World *-- "0..*" Triangle : Szene
World ..> Hit : nächster Treffer
Renderer ..> Camera : Primärstrahlen
Renderer ..> World : Primär- und Folgestrahlen
Renderer ..> RenderStats : Zähler

@enduml
